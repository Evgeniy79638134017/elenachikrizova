---
const specializations = [
  {
    icon: `<svg class="w-12 h-12 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
    </svg>`,
    title: 'Эндокринология',
    description: 'Щитовидная железа, диабет, метаболический синдром, дефицитные состояния. 30 лет опыта, включая редкие диагнозы.',
    href: '/uslugi/endokrinologiya',
  },
  {
    icon: `<svg class="w-12 h-12 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
    </svg>`,
    title: 'Гирудотерапия',
    description: 'Более 180 ферментов для восстановления. 15+ лет практики, обучение в Сеченовском университете.',
    href: '/uslugi/girudoterapiya',
  },
  {
    icon: `<svg class="w-12 h-12 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
    </svg>`,
    title: 'Нутрициология',
    description: 'Клеточное питание и восполнение дефицитов. Индивидуальный подбор нутрицевтиков.',
    href: '/uslugi/nutriciologiya',
  },
];
---

<section id="specializations" class="bg-white">
  <div class="max-w-6xl mx-auto px-4 md:px-6 py-20 md:py-28">
    <div class="text-center">
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-deep">
        Три направления — один системный подход
      </h2>
      <p class="text-text-secondary text-lg mt-4 max-w-2xl mx-auto">
        Каждое направление усиливает эффект остальных
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 mt-12">
      {specializations.map((spec) => (
        <div class="animate-on-scroll bg-white rounded-2xl shadow-md p-8 hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
          <div set:html={spec.icon} />
          <h3 class="font-heading text-xl font-semibold text-deep mt-6">
            {spec.title}
          </h3>
          <p class="text-text-secondary mt-3">
            {spec.description}
          </p>
          <a
            href={spec.href}
            class="inline-block text-primary font-semibold mt-4 hover:text-primary-dark transition"
          >
            Подробнее →
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
