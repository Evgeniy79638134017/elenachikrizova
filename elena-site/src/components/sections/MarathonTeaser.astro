---
const benefits = [
  '66 участников — все получили результат',
  'Врачебный контроль на каждом этапе',
  'Питание + вода + движение + режим дня',
];

const days = [
  { day: '1', title: 'Учимся пить воду' },
  { day: '3', title: 'Разбираем питание и дефициты' },
  { day: '5', title: 'Физическая нагрузка и кундалини' },
  { day: '7', title: 'Закрепляем привычки. Результаты' },
];
---

<section class="bg-warm-light">
  <div class="max-w-6xl mx-auto px-4 md:px-6 py-20 md:py-28">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Left: Text -->
      <div>
        <span class="bg-primary/10 text-primary text-sm font-semibold px-3 py-1 rounded-full inline-block">
          Онлайн-марафон
        </span>
        <h2 class="font-heading text-4xl md:text-5xl font-bold text-deep mt-4">
          Энергия стройности
        </h2>
        <p class="text-text-secondary text-xl mt-3">
          7 дней, которые меняют привычки
        </p>

        <div class="flex flex-col gap-3 mt-6">
          {benefits.map((item) => (
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-success flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-deep text-lg">{item}</span>
            </div>
          ))}
        </div>

        <blockquote class="border-l-4 border-primary pl-4 mt-6">
          <p class="text-text-secondary italic text-base">
            «Одна участница потеряла 10 кг за 7 дней — просто начала пить воду и правильно питаться»
          </p>
        </blockquote>
        <p class="text-text-light text-sm mt-2">
          Результаты индивидуальны. Исходный вес участницы — 130 кг.
        </p>

        <div class="flex items-center gap-4 mt-8">
          <a
            href="/maraton"
            class="bg-primary text-white rounded-xl px-10 py-4 text-lg font-semibold hover:bg-primary-dark transition"
          >
            Подробнее о марафоне
          </a>
          <span class="text-text-secondary font-semibold text-xl">5 000 ₽</span>
        </div>
      </div>

      <!-- Right: Visual Card -->
      <div class="animate-on-scroll bg-white rounded-2xl shadow-lg p-8 hover:shadow-xl transition-all duration-300">
        <p class="font-heading font-semibold text-deep text-xl mb-6">Программа марафона</p>
        <div class="flex flex-col gap-4">
          {days.map((item) => (
            <div class="flex items-center gap-3">
              <span class="bg-primary/10 text-primary w-8 h-8 rounded-full flex items-center justify-center text-base font-bold flex-shrink-0">
                {item.day}
              </span>
              <span class="text-deep text-lg">День {item.day}: {item.title}</span>
            </div>
          ))}
        </div>
        <p class="text-text-light text-sm mt-6">
          Формат: видео + задания + поддержка
        </p>
      </div>
    </div>
  </div>
</section>
