---
const testimonials = [
  {
    quote: 'Просили и до сих пор пишут и звонят: «Мы хотим продолжение!»',
    name: 'Участницы марафона',
    source: 'Марафон «Энергия стройности»',
    rating: 5,
    initials: 'УМ',
  },
  {
    quote: 'Выбираю именно Елену как доктора. Приезжаю из района специально к ней.',
    name: 'Пациентка',
    source: 'Южно-Сахалинск',
    rating: 5,
    initials: 'НК',
  },
  {
    quote: 'Благодарны за открытость и честность. Врач всё объясняет от и до.',
    name: 'Отзыв с ПроДокторов',
    source: 'Эндокринология',
    rating: 5,
    initials: 'ОП',
  },
];
---

<section class="bg-warm-light">
  <div class="max-w-6xl mx-auto px-4 md:px-6 py-20 md:py-28">
    <h2 class="font-heading text-4xl md:text-5xl font-bold text-deep text-center">
      Что говорят пациенты
    </h2>

    <div class="grid md:grid-cols-3 gap-8 mt-12">
      {testimonials.map((item) => (
        <div class="animate-on-scroll card-hover bg-white rounded-2xl shadow-md p-8 border border-warm-dark/10">
          <div class="flex items-center gap-1 mb-4">
            {[...Array(item.rating)].map(() => (
              <svg class="w-5 h-5 text-amber-400 fill-current" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>

          <blockquote class="text-text-secondary text-lg leading-relaxed">
            «{item.quote}»
          </blockquote>

          <div class="flex items-center gap-4 mt-6 pt-6 border-t border-warm-dark/10">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
              <span class="text-primary font-semibold text-base">{item.initials}</span>
            </div>
            <div>
              <p class="text-deep font-semibold">{item.name}</p>
              <p class="text-text-light text-sm">{item.source}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
