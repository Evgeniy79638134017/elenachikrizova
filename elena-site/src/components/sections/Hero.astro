---
---

<section class="bg-gradient-to-b from-bg to-warm-light">
  <div class="max-w-6xl mx-auto px-4 md:px-6 py-20 md:py-28">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Text -->
      <div>
        <p class="text-primary-text font-semibold text-base uppercase tracking-wide">
          Врач-эндокринолог · 30 лет опыта
        </p>
        <h1 class="font-heading text-5xl md:text-6xl font-bold text-deep leading-tight mt-4">
          Системный подход к вашему здоровью
        </h1>
        <p class="text-text-secondary text-xl leading-relaxed mt-6">
          Эндокринология, гирудотерапия и нутрициология — три направления, которые работают вместе.
          Нахожу путь наименьшей затраты энергии, чтобы вы быстрее вышли из болезненного состояния.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 mt-8">
          <a
            href="/kontakty"
            class="btn-hover inline-block text-center bg-primary text-white rounded-xl px-10 py-4 text-lg font-semibold hover:bg-primary-dark"
          >
            Записаться на приём
          </a>
          <a
            href="#specializations"
            class="inline-block text-center border-2 border-primary text-primary rounded-xl px-8 py-3.5 text-base font-semibold hover:bg-primary hover:text-white transition"
          >
            Узнать больше
          </a>
        </div>
      </div>

      <!-- Photo -->
      <div class="flex justify-center lg:justify-end">
        <img
          src="/images/doctor/elena-hero.jpg"
          alt="Елена Чикризова — врач-эндокринолог"
          class="rounded-3xl w-full max-w-md shadow-xl object-cover aspect-[4/5]"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>
