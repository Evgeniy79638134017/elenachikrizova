---
const navLinks = [
  { href: '/', label: 'Главная' },
  { href: '/about', label: 'Обо мне' },
  { href: '/kejsy', label: 'Кейсы' },
  { href: '/blog', label: 'Блог' },
  { href: '/kontakty', label: 'Контакты' },
];

const serviceLinks = [
  { href: '/uslugi', label: 'Все услуги' },
  { href: '/uslugi/endokrinologiya', label: 'Эндокринология' },
  { href: '/uslugi/girudoterapiya', label: 'Гирудотерапия' },
  { href: '/uslugi/nutriciologiya', label: 'Нутрициология' },
];

const mobileNavLinks = [
  { href: '/', label: 'Главная' },
  { href: '/about', label: 'Обо мне' },
  { href: '/uslugi/endokrinologiya', label: 'Эндокринология' },
  { href: '/uslugi/girudoterapiya', label: 'Гирудотерапия' },
  { href: '/uslugi/nutriciologiya', label: 'Нутрициология' },
  { href: '/kejsy', label: 'Кейсы' },
  { href: '/blog', label: 'Блог' },
  { href: '/kontakty', label: 'Контакты' },
];
---

<header transition:persist class="fixed top-0 w-full z-50 bg-white/95 backdrop-blur-md shadow-sm">
  <div class="max-w-6xl mx-auto px-4 md:px-6 h-20 md:h-24 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex flex-col">
      <span class="font-heading font-semibold text-deep text-xl md:text-2xl">Елена Чикризова</span>
      <span class="font-body text-text-secondary text-sm md:text-base">врач-эндокринолог</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-8">
      {navLinks.slice(0, 2).map((link) => (
        <a href={link.href} class="text-deep text-base md:text-lg hover:text-primary transition">
          {link.label}
        </a>
      ))}

      <!-- Dropdown Услуги -->
      <div class="relative group">
        <a
          href="/uslugi"
          class="text-deep text-base md:text-lg hover:text-primary transition flex items-center gap-1"
        >
          Услуги
          <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </a>

        <div class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
          <div class="bg-white rounded-xl shadow-xl border border-warm-dark/10 py-2 min-w-48">
            {serviceLinks.map((link) => (
              <a
                href={link.href}
                class="block px-5 py-2.5 text-deep hover:bg-warm-light hover:text-primary transition"
              >
                {link.label}
              </a>
            ))}
          </div>
        </div>
      </div>

      {navLinks.slice(2).map((link) => (
        <a href={link.href} class="text-deep text-base md:text-lg hover:text-primary transition">
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Desktop CTA -->
    <a
      href="/kontakty"
      class="hidden lg:block bg-primary text-white rounded-xl px-8 py-3 text-base md:text-lg font-semibold hover:bg-primary-dark transition"
    >
      Записаться
    </a>

    <!-- Burger Button -->
    <button
      id="menu-toggle"
      class="lg:hidden flex flex-col justify-center items-center w-10 h-10 relative z-50 cursor-pointer"
      aria-label="Открыть меню"
    >
      <span class="burger-line w-7 h-0.5 bg-deep rounded-full transition-all duration-300 ease-out"></span>
      <span class="burger-line w-7 h-0.5 bg-deep rounded-full transition-all duration-300 ease-out mt-1.5"></span>
      <span class="burger-line w-7 h-0.5 bg-deep rounded-full transition-all duration-300 ease-out mt-1.5"></span>
    </button>
  </div>
</header>

<!-- Mobile Menu -->
<div
  id="mobile-menu"
  class="fixed inset-0 bg-white z-50 opacity-0 invisible transition-all duration-300 ease-out"
>
  <!-- Header -->
  <div class="flex items-center justify-between px-4 py-4 border-b border-warm-dark/10">
    <div>
      <p class="font-heading text-xl font-bold text-deep">Елена Чикризова</p>
      <p class="text-text-light text-sm">врач-эндокринолог</p>
    </div>
    <button
      id="menu-close"
      class="w-10 h-10 flex items-center justify-center"
      aria-label="Закрыть меню"
    >
      <svg class="w-6 h-6 text-deep" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- Navigation Links -->
  <nav class="flex flex-col items-center justify-center h-[calc(100vh-180px)] gap-6">
    {mobileNavLinks.map((link, index) => (
      <a
        href={link.href}
        class="mobile-nav-link text-deep text-2xl font-medium hover:text-primary transition-colors duration-200 opacity-0 translate-y-4 cursor-pointer"
        style={`transition-delay: ${index * 50}ms`}
      >
        {link.label}
      </a>
    ))}
  </nav>

  <!-- CTA -->
  <div class="absolute bottom-0 left-0 right-0 p-6 border-t border-warm-dark/10">
    <a
      href="/kontakty"
      class="mobile-nav-link flex items-center justify-center gap-2 w-full py-4 bg-primary text-white text-lg font-semibold rounded-xl opacity-0 translate-y-4 cursor-pointer"
      style="transition-delay: 400ms"
    >
      Записаться
    </a>
  </div>
</div>

<script>
  (function() {
    let initialized = false;

    function initMobileMenu() {
      const menuToggle = document.getElementById('menu-toggle');
      const menuClose = document.getElementById('menu-close');
      const mobileMenu = document.getElementById('mobile-menu');

      if (!menuToggle || !mobileMenu) return;

      // Предотвращаем повторную инициализацию
      if (menuToggle.dataset.initialized === 'true') return;
      menuToggle.dataset.initialized = 'true';

      const navLinks = mobileMenu.querySelectorAll('.mobile-nav-link');
      const burgerLines = menuToggle.querySelectorAll('.burger-line');

      function openMenu() {
        // Показываем меню
        mobileMenu.classList.remove('opacity-0', 'invisible');
        mobileMenu.classList.add('opacity-100', 'visible');

        // Анимируем бургер в крестик
        if (burgerLines && burgerLines.length === 3) {
          burgerLines[0].classList.add('rotate-45', 'translate-y-2');
          burgerLines[1].classList.add('opacity-0', 'scale-0');
          burgerLines[2].classList.add('-rotate-45', '-translate-y-2');
        }

        // Анимируем пункты меню
        navLinks.forEach(link => {
          link.classList.remove('opacity-0', 'translate-y-4');
          link.classList.add('opacity-100', 'translate-y-0');
        });

        // Блокируем скролл
        document.body.style.overflow = 'hidden';
        menuToggle.setAttribute('aria-label', 'Закрыть меню');
      }

      function closeMenu() {
        // Скрываем пункты сначала
        navLinks.forEach(link => {
          link.classList.add('opacity-0', 'translate-y-4');
          link.classList.remove('opacity-100', 'translate-y-0');
        });

        // Анимируем крестик обратно в бургер
        if (burgerLines && burgerLines.length === 3) {
          burgerLines[0].classList.remove('rotate-45', 'translate-y-2');
          burgerLines[1].classList.remove('opacity-0', 'scale-0');
          burgerLines[2].classList.remove('-rotate-45', '-translate-y-2');
        }

        // Скрываем меню с задержкой
        setTimeout(() => {
          mobileMenu.classList.add('opacity-0', 'invisible');
          mobileMenu.classList.remove('opacity-100', 'visible');
        }, 200);

        // Разблокируем скролл
        document.body.style.overflow = '';
        menuToggle.setAttribute('aria-label', 'Открыть меню');
      }

      function toggleMenu(e) {
        e.stopPropagation();
        const isOpen = mobileMenu.classList.contains('opacity-100');
        if (isOpen) {
          closeMenu();
        } else {
          openMenu();
        }
      }

      menuToggle.addEventListener('click', toggleMenu);
      menuClose?.addEventListener('click', closeMenu);

      // Закрытие при клике на ссылку
      navLinks.forEach(link => {
        link.addEventListener('click', closeMenu);
      });

      // Закрытие по Escape (только один раз)
      if (!initialized) {
        initialized = true;
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && mobileMenu.classList.contains('opacity-100')) {
            closeMenu();
          }
        });
      }
    }

    // Инициализация при загрузке
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMobileMenu);
    } else {
      initMobileMenu();
    }

    // Реинициализация после View Transitions
    document.addEventListener('astro:page-load', initMobileMenu);
  })();
</script>
