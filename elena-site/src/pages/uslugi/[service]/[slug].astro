---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SeoSchema from '../../../components/SeoSchema.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const conditions = await getCollection('conditions', ({ data }) => !data.draft);
  return conditions.map((condition) => ({
    params: {
      service: condition.data.service,
      slug: condition.slug.split('/').pop() // Get just the filename without service folder
    },
    props: { condition },
  }));
}

const { condition } = Astro.props;
const { Content } = await render(condition);

const serviceLabels: Record<string, string> = {
  endokrinologiya: 'Эндокринология',
  girudoterapiya: 'Гирудотерапия',
  nutriciologiya: 'Нутрициология',
};

const breadcrumbs = [
  { label: 'Главная', href: '/' },
  { label: serviceLabels[condition.data.service], href: `/uslugi/${condition.data.service}` },
  { label: condition.data.title },
];

const pageTitle = condition.data.seoTitle || `${condition.data.title} — ${serviceLabels[condition.data.service]}`;
const pageDescription = condition.data.seoDescription || condition.data.description;

const schemaData = {
  name: condition.data.title,
  description: condition.data.description,
  medicalSpecialty: serviceLabels[condition.data.service],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
>
  <SeoSchema type="MedicalCondition" data={schemaData} slot="head" />

  <article class="bg-white">
    <div class="max-w-4xl mx-auto px-4 md:px-6 py-16 md:py-24">
      <Breadcrumbs items={breadcrumbs} />

      <!-- Header -->
      <header>
        <span class="bg-primary/10 text-primary text-sm font-semibold px-3 py-1 rounded-full">
          {serviceLabels[condition.data.service]}
        </span>
        <h1 class="font-heading text-4xl md:text-5xl font-bold text-deep mt-4">
          {condition.data.title}
        </h1>
        <p class="text-text-secondary text-xl mt-4 leading-relaxed">
          {condition.data.description}
        </p>
      </header>

      <!-- Quick Info Cards -->
      {(condition.data.symptoms || condition.data.riskFactors || condition.data.tests) && (
        <div class="grid md:grid-cols-3 gap-6 mt-12">
          {condition.data.symptoms && condition.data.symptoms.length > 0 && (
            <div class="bg-warm-light rounded-2xl p-6">
              <h2 class="font-heading text-xl font-semibold text-deep mb-4">Симптомы</h2>
              <ul class="space-y-2">
                {condition.data.symptoms.map((symptom) => (
                  <li class="flex items-start gap-2 text-text-secondary text-base">
                    <span class="text-primary mt-1">•</span>
                    <span>{symptom}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {condition.data.riskFactors && condition.data.riskFactors.length > 0 && (
            <div class="bg-warm-light rounded-2xl p-6">
              <h2 class="font-heading text-xl font-semibold text-deep mb-4">Факторы риска</h2>
              <ul class="space-y-2">
                {condition.data.riskFactors.map((factor) => (
                  <li class="flex items-start gap-2 text-text-secondary text-base">
                    <span class="text-primary mt-1">•</span>
                    <span>{factor}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {condition.data.tests && condition.data.tests.length > 0 && (
            <div class="bg-warm-light rounded-2xl p-6">
              <h2 class="font-heading text-xl font-semibold text-deep mb-4">Анализы</h2>
              <ul class="space-y-2">
                {condition.data.tests.map((test) => (
                  <li class="flex items-start gap-2 text-text-secondary text-base">
                    <span class="text-primary mt-1">•</span>
                    <span>{test}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      )}

      <!-- Main Content -->
      <div class="prose prose-lg max-w-none mt-12">
        <Content />
      </div>

      <!-- CTA -->
      <div class="bg-gradient-to-r from-primary to-primary-dark rounded-2xl p-8 md:p-12 mt-12 text-center">
        <h2 class="font-heading text-2xl md:text-3xl font-bold text-white">
          Запишитесь на консультацию
        </h2>
        <p class="text-white/80 text-lg mt-3">
          Разберёмся в вашей ситуации и составим план действий
        </p>
        <a
          href="/kontakty"
          class="inline-block bg-white text-primary rounded-xl px-10 py-4 text-lg font-semibold hover:bg-warm-light transition mt-6"
        >
          Записаться на приём
        </a>
      </div>

      <!-- Related Conditions -->
      {condition.data.relatedConditions && condition.data.relatedConditions.length > 0 && (
        <div class="mt-12">
          <h2 class="font-heading text-2xl font-bold text-deep mb-6">Связанные темы</h2>
          <div class="flex flex-wrap gap-3">
            {condition.data.relatedConditions.map((slug) => (
              <a
                href={`/uslugi/${condition.data.service}/${slug}`}
                class="bg-warm-light text-deep px-4 py-2 rounded-full hover:bg-primary hover:text-white transition text-base"
              >
                {slug.replace(/-/g, ' ')}
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </article>
</BaseLayout>

<style is:global>
  .prose {
    color: #4A5568;
    line-height: 1.75;
    font-size: 1.125rem;
  }
  .prose h2 {
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    font-size: 1.75rem;
    color: #1E3A5F;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .prose h3 {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: 1.5rem;
    color: #1E3A5F;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .prose p {
    margin-bottom: 1.25rem;
  }
  .prose strong {
    color: #1E3A5F;
    font-weight: 600;
  }
  .prose ul, .prose ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  .prose li {
    margin-bottom: 0.5rem;
  }
  .prose blockquote {
    border-left: 4px solid #6BA5A5;
    padding-left: 1rem;
    font-style: italic;
    color: #4A5568;
    margin: 1.5rem 0;
  }
  .prose a {
    color: #6BA5A5;
    text-decoration: underline;
  }
  .prose a:hover {
    color: #4F8A8A;
  }
</style>
