---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Страница не найдена"
  description="Запрашиваемая страница не найдена на сайте elenachekrizova.ru"
>
  <section class="bg-white">
    <div class="max-w-2xl mx-auto px-4 md:px-6 py-20 md:py-28 text-center">
      <span class="text-primary font-heading text-8xl font-bold opacity-30">404</span>
      <h1 class="font-heading text-2xl md:text-3xl font-bold text-deep mt-4">
        Страница не найдена
      </h1>
      <p class="text-text-secondary mt-3">
        Возможно, она была перемещена или удалена
      </p>
      <div class="flex gap-4 justify-center mt-8">
        <a
          href="/"
          class="bg-primary text-white rounded-xl px-8 py-3.5 font-semibold hover:bg-primary-dark transition"
        >
          На главную
        </a>
        <a
          href="/kontakty"
          class="border-2 border-primary text-primary rounded-xl px-8 py-3.5 font-semibold hover:bg-primary hover:text-white transition"
        >
          Контакты
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
