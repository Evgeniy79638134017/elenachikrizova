---
import BaseLayout from '../layouts/BaseLayout.astro';

const steps = [
  {
    number: '1',
    title: 'Запись',
    description: 'Вы оставляете заявку, я связываюсь с вами и подбираю удобное время',
  },
  {
    number: '2',
    title: 'Приём и диагностика',
    description: 'Анализирую историю болезни, назначаю обследования, смотрю анализы за последние годы',
  },
  {
    number: '3',
    title: 'Индивидуальный план',
    description: 'Составляю системный план: медикаменты, нутрицевтики, гирудотерапия, питание. Остаюсь на связи',
  },
];
---

<BaseLayout
  title="Контакты — Елена Чикризова"
  description="Запишитесь на приём к врачу-эндокринологу. Южно-Сахалинск, клиники Медскан и Клинклиник. Стоимость приёма 2 700 ₽."
>
  <!-- Section 1: Mini Hero -->
  <section class="bg-gradient-to-b from-bg to-warm-light">
    <div class="max-w-6xl mx-auto px-4 md:px-6 py-16 md:py-24 text-center">
      <img
        src="/images/doctor/elena-hero.jpg"
        alt="Елена Чикризова"
        class="w-24 h-24 rounded-full object-cover border-4 border-primary/20 shadow-xl mx-auto mb-6"
      />
      <h1 class="font-heading text-5xl md:text-6xl font-bold text-deep">
        Запишитесь на приём
      </h1>
      <p class="text-text-secondary text-xl mt-4">
        Первый шаг к системному восстановлению здоровья
      </p>
    </div>
  </section>

  <!-- Section 2: Form + Info -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-4 md:px-6 py-20 md:py-28">
      <div class="grid lg:grid-cols-5 gap-12">
        <!-- Left: Form -->
        <div class="lg:col-span-3">
          <h2 class="font-heading text-3xl font-bold text-deep">
            Оставьте заявку
          </h2>
          <p class="text-text-secondary text-lg mt-2">
            Заполните форму, и я свяжусь с вами для уточнения времени приёма
          </p>

          <form action="https://formspree.io/f/placeholder" method="POST" class="mt-8 space-y-5">
            <!-- Name -->
            <div>
              <label class="block text-base font-semibold text-deep mb-1.5">Ваше имя *</label>
              <input
                type="text"
                name="name"
                required
                placeholder="Елена Иванова"
                class="w-full px-4 py-3 rounded-xl border border-warm-dark/30 bg-white text-deep placeholder:text-text-light focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition"
              />
            </div>

            <!-- Phone -->
            <div>
              <label class="block text-base font-semibold text-deep mb-1.5">Телефон *</label>
              <input
                type="tel"
                name="phone"
                required
                placeholder="+7 (999) 123-45-67"
                class="w-full px-4 py-3 rounded-xl border border-warm-dark/30 bg-white text-deep placeholder:text-text-light focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition"
              />
            </div>

            <!-- Email -->
            <div>
              <label class="block text-base font-semibold text-deep mb-1.5">Email</label>
              <input
                type="email"
                name="email"
                placeholder="email@example.com"
                class="w-full px-4 py-3 rounded-xl border border-warm-dark/30 bg-white text-deep placeholder:text-text-light focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition"
              />
            </div>

            <!-- Service -->
            <div>
              <label class="block text-base font-semibold text-deep mb-1.5">Направление консультации</label>
              <select
                name="service"
                class="w-full px-4 py-3 rounded-xl border border-warm-dark/30 bg-white text-deep focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition appearance-none"
              >
                <option value="">Не определилась</option>
                <option value="endokrinologiya">Эндокринология</option>
                <option value="girudoterapiya">Гирудотерапия</option>
                <option value="nutriciologiya">Нутрициология</option>
                <option value="maraton">Марафон «Энергия стройности»</option>
              </select>
            </div>

            <!-- Message -->
            <div>
              <label class="block text-base font-semibold text-deep mb-1.5">Сообщение</label>
              <textarea
                name="message"
                rows="4"
                placeholder="Опишите вашу ситуацию или задайте вопрос"
                class="w-full px-4 py-3 rounded-xl border border-warm-dark/30 bg-white text-deep placeholder:text-text-light focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition resize-none"
              ></textarea>
            </div>

            <!-- Consent -->
            <div>
              <label class="flex items-start gap-3 text-base text-text-secondary cursor-pointer">
                <input
                  type="checkbox"
                  name="consent"
                  required
                  class="mt-1 w-5 h-5 accent-primary"
                />
                <span>
                  Я соглашаюсь на <a href="/privacy" class="text-primary hover:underline">обработку персональных данных</a> и принимаю условия <a href="/oferta" class="text-primary hover:underline">оферты</a>
                </span>
              </label>
            </div>

            <!-- Submit -->
            <button
              type="submit"
              class="btn-hover bg-primary text-white rounded-xl px-10 py-4 font-semibold text-lg hover:bg-primary-dark w-full md:w-auto"
            >
              Отправить заявку
            </button>
          </form>
        </div>

        <!-- Right: Info Cards -->
        <div class="lg:col-span-2">
          <!-- Price Card -->
          <div class="bg-warm-light rounded-2xl p-6">
            <h3 class="font-heading text-2xl font-bold text-deep">Стоимость приёма</h3>
            <p class="text-primary text-3xl font-bold font-heading mt-2">2 700 ₽</p>
            <p class="text-text-secondary text-base mt-1">Продолжительность: 30–60 минут</p>
            <p class="text-text-secondary text-base">Повторный приём: по результатам</p>
          </div>

          <!-- Clinics Card -->
          <div class="bg-warm-light rounded-2xl p-6 mt-4">
            <h3 class="font-heading text-2xl font-bold text-deep">Где принимаю</h3>
            <div class="mt-3">
              <p class="font-semibold text-deep text-lg">Медскан</p>
              <p class="text-text-secondary text-base">Южно-Сахалинск</p>
            </div>
            <div class="border-t border-warm-dark/20 my-3"></div>
            <div>
              <p class="font-semibold text-deep text-lg">Клинклиник</p>
              <p class="text-text-secondary text-base">Частная практика</p>
            </div>
          </div>

          <!-- Contact Card -->
          <div class="bg-warm-light rounded-2xl p-6 mt-4">
            <h3 class="font-heading text-2xl font-bold text-deep">Связаться напрямую</h3>
            <div class="mt-4 space-y-3">
              <a href="https://t.me/+sWVDcnHhddMzOGIy" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-deep hover:text-primary transition">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"></path>
                </svg>
                <span>Telegram</span>
              </a>
              <a href="https://wa.me/79850693545" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-deep hover:text-primary transition">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>
                </svg>
                <span>WhatsApp</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: How it works -->
  <section class="bg-warm-light">
    <div class="max-w-4xl mx-auto px-4 md:px-6 py-20 md:py-28">
      <h2 class="font-heading text-4xl md:text-5xl font-bold text-deep text-center">
        Как проходит приём
      </h2>

      <div class="grid md:grid-cols-3 gap-8 mt-12">
        {steps.map((step) => (
          <div class="text-center">
            <div class="bg-primary text-white w-12 h-12 rounded-full mx-auto flex items-center justify-center text-xl font-bold">
              {step.number}
            </div>
            <h3 class="font-semibold text-deep text-lg mt-4">{step.title}</h3>
            <p class="text-text-secondary text-base mt-2">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
