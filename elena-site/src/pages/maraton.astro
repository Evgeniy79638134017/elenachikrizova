---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeoSchema from '../components/SeoSchema.astro';

const schemaData = {
  name: 'Марафон «Энергия стройности»',
  description: '7-дневный марафон снижения веса под контролем врача-эндокринолога',
  offers: {
    '@type': 'Offer',
    price: '5000',
    priceCurrency: 'RUB',
  },
};

const painPoints = [
  'Устала постоянно, нет сил ни на что',
  'Не могу похудеть — пробовала всё, ничего не помогает',
  'Депрессия, плохой сон, нет энергии',
  'Врачи говорят «всё нормально», а я чувствую, что нет',
  'Знаю, что нужно менять образ жизни, но не знаю с чего начать',
  'Хочу быть лёгкой, энергичной, счастливой',
];

const programDays = [
  {
    day: '01',
    title: 'Вода',
    description: 'Учимся правильно пить воду. Многие пьют всего 3 стакана в сутки — этого критически мало',
  },
  {
    day: '02',
    title: 'Питание',
    description: 'Разбираем диеты и находим то, что подходит именно вам. Знакомство с Слим Альфашейк',
  },
  {
    day: '03',
    title: 'Режим дня',
    description: 'Циркадные ритмы и их влияние на вес. Почему важно вставать рано',
  },
  {
    day: '04',
    title: 'Физическая нагрузка',
    description: 'От обычных упражнений до кундалини-йоги — для любого возраста и уровня',
  },
  {
    day: '05',
    title: 'Дефициты',
    description: 'Как дефициты витаминов и микроэлементов мешают снижению веса',
  },
  {
    day: '06',
    title: 'Системный подход',
    description: 'Объединяем все элементы в вашу персональную систему',
  },
  {
    day: '07',
    title: 'Привычка',
    description: '7 дней — старт, 40 дней — привычка на всю жизнь',
  },
];

const differences = [
  {
    title: 'Чекап до старта',
    description: 'Сначала анализы и выявление проблем, потом — марафон с коррекцией',
  },
  {
    title: 'Врачебный контроль',
    description: 'Не блогер, а врач-эндокринолог с 30-летним стажем ведёт марафон',
  },
  {
    title: 'Системный подход',
    description: 'Не одна таблетка, а система: вода + питание + режим + движение + нутриенты',
  },
];

const included = [
  '7 дней программы',
  'Врачебное сопровождение',
  'Рекомендации по питанию и воде',
  'Физические практики и кундалини-йога',
  'Чат поддержки',
];
---

<BaseLayout
  title="Марафон «Энергия стройности» | Похудение с врачом | 5 000 ₽"
  description="Онлайн-марафон по снижению веса с врачом-эндокринологом. 4 недели, индивидуальный подход, поддержка в чате. Уже 66 участников. Старт — каждый месяц."
>
  <SeoSchema type="Product" data={schemaData} slot="head" />
  <!-- Section 1: Hero -->
  <section class="grain-overlay bg-gradient-to-br from-deep via-deep/95 to-primary/20">
    <div class="max-w-6xl mx-auto px-4 md:px-6 py-20 md:py-28">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="bg-white/10 text-white text-sm font-semibold px-3 py-1 rounded-full">
            Врачебный марафон · 7 дней
          </span>
          <h1 class="font-heading text-5xl md:text-6xl font-bold text-white mt-4">
            Энергия стройности
          </h1>
          <p class="text-white/80 text-xl mt-4">
            7 дней, которые меняют привычки. Не диета — системный подход к снижению веса под контролем врача-эндокринолога с 30-летним стажем.
          </p>
          <div class="flex gap-8 mt-8 items-baseline">
            <span class="text-white font-heading text-4xl font-bold">66</span>
            <span class="text-white/70 text-base">участников — 66 результатов</span>
          </div>
          <a
            href="#price"
            class="btn-hover inline-block bg-white text-primary rounded-xl px-10 py-4 font-semibold text-lg hover:bg-warm-light mt-8"
          >
            Присоединиться к марафону
          </a>
        </div>
        <div class="flex justify-center lg:justify-end">
          <div class="bg-white/10 rounded-3xl aspect-square w-full max-w-sm flex items-center justify-center">
            <span class="text-8xl">🔥</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: For whom -->
  <section class="bg-white">
    <div class="max-w-4xl mx-auto px-4 md:px-6 py-20 md:py-28">
      <h2 class="font-heading text-4xl md:text-5xl font-bold text-deep text-center">
        Для кого этот марафон
      </h2>
      <p class="text-text-secondary text-xl text-center mt-3">
        Если вы узнаёте себя хотя бы в двух пунктах — марафон для вас
      </p>

      <div class="grid md:grid-cols-2 gap-6 mt-12">
        {painPoints.map((pain) => (
          <div class="bg-warm-light rounded-xl p-6">
            <p class="text-text-secondary italic text-lg">«{pain}»</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 3: Program -->
  <section class="bg-warm-light">
    <div class="max-w-6xl mx-auto px-4 md:px-6 py-20 md:py-28">
      <h2 class="font-heading text-4xl md:text-5xl font-bold text-deep text-center">
        Программа 7 дней
      </h2>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mt-12">
        {programDays.map((item) => (
          <div class="bg-white rounded-2xl shadow-md p-6">
            <span class="text-primary font-heading text-2xl font-bold">{item.day}</span>
            <h3 class="font-semibold text-deep text-lg mt-2">{item.title}</h3>
            <p class="text-text-secondary text-base mt-2">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 4: Why different -->
  <section class="bg-white">
    <div class="max-w-4xl mx-auto px-4 md:px-6 py-20 md:py-28">
      <h2 class="font-heading text-4xl md:text-5xl font-bold text-deep text-center">
        Почему это не просто диета
      </h2>

      <blockquote class="max-w-2xl mx-auto mt-8 border-l-4 border-primary pl-6">
        <div class="flex items-start gap-4">
          <img
            src="/images/doctor/elena-hero.jpg"
            alt="Елена Чикризова"
            class="w-16 h-16 rounded-full object-cover border-2 border-primary/20 shadow-md flex-shrink-0"
            style="object-position: center 30%"
          />
          <div>
            <p class="text-text-secondary text-xl italic">
              «Просто похудеть можно. Но когда ты всё-таки чекап провёл, доктор посмотрел — это уже другой подход. Это не просто рекомендация, а именно врачебный подход, где человек отвечает за тебя.»
            </p>
            <footer class="text-primary font-semibold text-base mt-3">Елена Чикризова</footer>
          </div>
        </div>
      </blockquote>

      <div class="grid md:grid-cols-3 gap-8 mt-12">
        {differences.map((item) => (
          <div class="text-center">
            <h3 class="font-semibold text-deep text-lg">{item.title}</h3>
            <p class="text-text-secondary text-base mt-2">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 5: Results -->
  <section class="bg-warm-light">
    <div class="max-w-6xl mx-auto px-4 md:px-6 py-20 md:py-28">
      <h2 class="font-heading text-4xl md:text-5xl font-bold text-deep text-center">
        Результаты участников
      </h2>

      <div class="bg-white rounded-2xl shadow-md p-8 max-w-3xl mx-auto mt-12">
        <h3 class="font-heading text-3xl font-bold text-deep text-center">
          66 участников — 66 результатов
        </h3>

        <div class="border-t border-warm-dark/20 my-6"></div>

        <p class="text-text-secondary italic text-lg">
          «Одна участница потеряла 10 кг за 7 дней. Что она начала делать? Начала пить воду — раньше пила всего три стакана в сутки. Обратила внимание на режим дня, добавила физические нагрузки.»
        </p>
        <p class="text-text-light text-base mt-2">Исходный вес — 130 кг</p>

        <div class="border-t border-warm-dark/20 my-6"></div>

        <p class="text-text-secondary text-lg">
          Все участники систематизировали свои дни, получили другое качество питания и остались довольны.
        </p>
      </div>

      <div class="max-w-2xl mx-auto mt-8 text-center">
        <p class="text-primary font-heading text-2xl italic">
          «Мы хотим продолжение! Как это сделать?»
        </p>
        <p class="text-text-light text-base mt-2">— участники марафона</p>
      </div>

      <p class="text-text-light text-sm text-center mt-8">
        Результаты индивидуальны и зависят от особенностей организма
      </p>
    </div>
  </section>

  <!-- Section 6: Price & CTA -->
  <section id="price" class="grain-overlay bg-gradient-to-r from-primary to-primary-dark">
    <div class="max-w-4xl mx-auto px-4 md:px-6 py-20 md:py-28 text-center">
      <h2 class="font-heading text-4xl md:text-5xl font-bold text-white">
        Присоединяйтесь к марафону
      </h2>
      <p class="text-white/80 text-xl mt-4">
        7 дней под контролем врача-эндокринолога
      </p>

      <div class="mt-8">
        <span class="text-white font-heading text-5xl font-bold">5 000 ₽</span>
        <p class="text-white/60 text-base mt-1">за полный курс</p>
      </div>

      <div class="mt-6 text-left max-w-sm mx-auto">
        {included.map((item) => (
          <div class="flex items-center gap-2 text-white/80 text-base py-1">
            <span class="text-white">✓</span>
            <span>{item}</span>
          </div>
        ))}
      </div>

      <a
        href="/kontakty"
        class="btn-hover inline-block bg-white text-primary rounded-xl px-10 py-4 font-semibold text-lg hover:bg-warm-light mt-8"
      >
        Записаться на марафон
      </a>
      <p class="text-white/50 text-base mt-4">
        Или напишите в Telegram для вопросов
      </p>
    </div>
  </section>
</BaseLayout>
