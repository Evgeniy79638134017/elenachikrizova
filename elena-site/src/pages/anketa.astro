---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Анкета пациента — Елена Чикризова"
  description="Заполните анкету перед консультацией для более эффективного приёма."
  noindex={true}
>
  <section class="bg-gradient-to-b from-bg to-warm-light">
    <div class="max-w-3xl mx-auto px-4 md:px-6 py-16 md:py-24">
      <div class="text-center">
        <h1 class="font-heading text-4xl md:text-5xl font-bold text-deep">
          Анкета пациента
        </h1>
        <p class="text-text-secondary text-xl mt-4">
          Заполните перед консультацией — это поможет подготовиться к приёму
        </p>
      </div>

      <form id="anketa-form" class="mt-12 space-y-6">
        <!-- Personal Info -->
        <div class="bg-white rounded-2xl p-6 shadow-md space-y-5">
          <h2 class="font-heading text-2xl font-bold text-deep">Личные данные</h2>

          <div>
            <label class="block text-base font-semibold text-deep mb-1.5">ФИО полностью *</label>
            <input
              type="text"
              name="fullname"
              required
              placeholder="Иванова Елена Петровна"
              class="w-full px-4 py-3 rounded-xl border border-warm-dark/30 bg-white text-deep placeholder:text-text-light focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition"
            />
          </div>

          <div class="grid md:grid-cols-2 gap-5">
            <div>
              <label class="block text-base font-semibold text-deep mb-1.5">Дата рождения *</label>
              <input
                type="date"
                name="birthdate"
                required
                class="w-full px-4 py-3 rounded-xl border border-warm-dark/30 bg-white text-deep focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition"
              />
            </div>
            <div>
              <label class="block text-base font-semibold text-deep mb-1.5">Город</label>
              <input
                type="text"
                name="city"
                placeholder="Южно-Сахалинск"
                class="w-full px-4 py-3 rounded-xl border border-warm-dark/30 bg-white text-deep placeholder:text-text-light focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition"
              />
            </div>
          </div>

          <div class="grid md:grid-cols-2 gap-5">
            <div>
              <label class="block text-base font-semibold text-deep mb-1.5">Рост (см)</label>
              <input
                type="number"
                name="height"
                placeholder="165"
                class="w-full px-4 py-3 rounded-xl border border-warm-dark/30 bg-white text-deep placeholder:text-text-light focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition"
              />
            </div>
            <div>
              <label class="block text-base font-semibold text-deep mb-1.5">Вес (кг)</label>
              <input
                type="number"
                name="weight"
                placeholder="65"
                class="w-full px-4 py-3 rounded-xl border border-warm-dark/30 bg-white text-deep placeholder:text-text-light focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition"
              />
            </div>
          </div>
        </div>

        <!-- Health Info -->
        <div class="bg-white rounded-2xl p-6 shadow-md space-y-5">
          <h2 class="font-heading text-2xl font-bold text-deep">Состояние здоровья</h2>

          <div>
            <label class="block text-base font-semibold text-deep mb-1.5">Основные жалобы *</label>
            <textarea
              name="complaints"
              required
              rows="4"
              placeholder="Опишите, что беспокоит: симптомы, когда началось, как проявляется"
              class="w-full px-4 py-3 rounded-xl border border-warm-dark/30 bg-white text-deep placeholder:text-text-light focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition resize-none"
            ></textarea>
          </div>

          <div>
            <label class="block text-base font-semibold text-deep mb-1.5">Хронические заболевания</label>
            <textarea
              name="chronic"
              rows="3"
              placeholder="Диабет, гипотиреоз, гипертония и т.д."
              class="w-full px-4 py-3 rounded-xl border border-warm-dark/30 bg-white text-deep placeholder:text-text-light focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition resize-none"
            ></textarea>
          </div>

          <div>
            <label class="block text-base font-semibold text-deep mb-1.5">Принимаемые препараты</label>
            <textarea
              name="medications"
              rows="3"
              placeholder="Название, дозировка, как давно принимаете"
              class="w-full px-4 py-3 rounded-xl border border-warm-dark/30 bg-white text-deep placeholder:text-text-light focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition resize-none"
            ></textarea>
          </div>

          <div>
            <label class="block text-base font-semibold text-deep mb-1.5">Аллергии</label>
            <input
              type="text"
              name="allergies"
              placeholder="На лекарства, продукты или нет аллергий"
              class="w-full px-4 py-3 rounded-xl border border-warm-dark/30 bg-white text-deep placeholder:text-text-light focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition"
            />
          </div>
        </div>

        <!-- Lifestyle -->
        <div class="bg-white rounded-2xl p-6 shadow-md space-y-5">
          <h2 class="font-heading text-2xl font-bold text-deep">Образ жизни</h2>

          <div>
            <label class="block text-base font-semibold text-deep mb-1.5">Качество сна (1 — плохо, 10 — отлично)</label>
            <input
              type="range"
              name="sleep"
              min="1"
              max="10"
              value="5"
              class="w-full accent-primary"
            />
            <div class="flex justify-between text-text-light text-sm mt-1">
              <span>1 — плохо</span>
              <span id="sleep-value" class="text-primary font-semibold">5</span>
              <span>10 — отлично</span>
            </div>
          </div>

          <div>
            <label class="block text-base font-semibold text-deep mb-1.5">Уровень стресса (1 — низкий, 10 — высокий)</label>
            <input
              type="range"
              name="stress"
              min="1"
              max="10"
              value="5"
              class="w-full accent-primary"
            />
            <div class="flex justify-between text-text-light text-sm mt-1">
              <span>1 — низкий</span>
              <span id="stress-value" class="text-primary font-semibold">5</span>
              <span>10 — высокий</span>
            </div>
          </div>
        </div>

        <!-- Goals -->
        <div class="bg-white rounded-2xl p-6 shadow-md space-y-5">
          <h2 class="font-heading text-2xl font-bold text-deep">Цели</h2>

          <div>
            <label class="block text-base font-semibold text-deep mb-1.5">Что хотите получить от консультации?</label>
            <textarea
              name="goals"
              rows="3"
              placeholder="Разобраться с анализами, получить план лечения, скорректировать питание и т.д."
              class="w-full px-4 py-3 rounded-xl border border-warm-dark/30 bg-white text-deep placeholder:text-text-light focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition resize-none"
            ></textarea>
          </div>
        </div>

        <!-- Status message -->
        <div id="anketa-status" class="hidden rounded-xl px-4 py-3 text-base font-medium"></div>

        <!-- Submit -->
        <button
          type="submit"
          id="anketa-btn"
          class="btn-hover bg-primary text-white rounded-xl px-10 py-4 font-semibold text-lg hover:bg-primary-dark w-full disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Отправить анкету
        </button>
      </form>
    </div>
  </section>

  <script>
    const sleepInput = document.querySelector('input[name="sleep"]') as HTMLInputElement;
    const stressInput = document.querySelector('input[name="stress"]') as HTMLInputElement;
    const sleepValue = document.getElementById('sleep-value')!;
    const stressValue = document.getElementById('stress-value')!;

    sleepInput.addEventListener('input', () => { sleepValue.textContent = sleepInput.value; });
    stressInput.addEventListener('input', () => { stressValue.textContent = stressInput.value; });

    const form = document.getElementById('anketa-form') as HTMLFormElement;
    const submitBtn = document.getElementById('anketa-btn') as HTMLButtonElement;
    const statusEl = document.getElementById('anketa-status') as HTMLDivElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const data: Record<string, string> = {};
      formData.forEach((value, key) => { data[key] = value.toString(); });

      submitBtn.disabled = true;
      submitBtn.textContent = 'Отправка...';
      statusEl.classList.add('hidden');

      try {
        const res = await fetch('/api/submit-anketa', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        if (res.ok) {
          statusEl.textContent = 'Анкета отправлена! Елена изучит её перед консультацией.';
          statusEl.className = 'rounded-xl px-4 py-3 text-base font-medium bg-green-50 text-green-700 border border-green-200';
          form.reset();
          sleepValue.textContent = '5';
          stressValue.textContent = '5';
        } else {
          const result = await res.json();
          statusEl.textContent = result.error || 'Ошибка при отправке. Попробуйте ещё раз.';
          statusEl.className = 'rounded-xl px-4 py-3 text-base font-medium bg-red-50 text-red-700 border border-red-200';
        }
      } catch {
        statusEl.textContent = 'Ошибка сети. Проверьте подключение и попробуйте ещё раз.';
        statusEl.className = 'rounded-xl px-4 py-3 text-base font-medium bg-red-50 text-red-700 border border-red-200';
      }

      submitBtn.disabled = false;
      submitBtn.textContent = 'Отправить анкету';
    });
  </script>
</BaseLayout>
