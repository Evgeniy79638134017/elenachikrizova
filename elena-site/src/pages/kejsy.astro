---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const cases = await getCollection('cases');
const sortedCases = cases.sort((a, b) => a.data.order - b.data.order);

const categoryLabels: Record<string, string> = {
  endokrinologiya: 'Эндокринология',
  girudoterapiya: 'Гирудотерапия',
  nutriciologiya: 'Нутрициология',
};
---

<BaseLayout
  title="Кейсы пациентов — Елена Чекризова"
  description="Реальные истории пациентов. Эндокринология, гирудотерапия, нутрициология. Результаты системного подхода."
>
  <!-- Mini Hero -->
  <section class="bg-gradient-to-b from-bg to-warm-light">
    <div class="max-w-6xl mx-auto px-4 md:px-6 py-16 md:py-24">
      <h1 class="font-heading text-4xl md:text-5xl font-bold text-deep">
        Истории пациентов
      </h1>
      <p class="text-text-secondary text-lg mt-4 max-w-2xl">
        Реальные случаи из 30-летней практики. Каждая история — пример системного подхода.
      </p>
    </div>
  </section>

  <!-- Cases Grid -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-4 md:px-6 py-16 md:py-24">
      <div class="grid md:grid-cols-2 gap-8">
        {sortedCases.map((caseItem) => (
          <article class="bg-warm-light rounded-2xl p-8">
            <span class="bg-primary/10 text-primary text-xs font-semibold px-3 py-1 rounded-full">
              {categoryLabels[caseItem.data.category]}
            </span>
            <h2 class="font-heading text-xl font-bold text-deep mt-3">
              {caseItem.data.title}
            </h2>
            <p class="text-text-secondary text-sm mt-2">
              {caseItem.data.description}
            </p>
            <p class="text-primary font-semibold text-sm mt-3">
              Результат: {caseItem.data.result}
            </p>
            <p class="text-text-light text-xs mt-2">
              {caseItem.data.disclaimer}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-warm-light">
    <div class="max-w-4xl mx-auto px-4 md:px-6 py-16 md:py-20 text-center">
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-deep">
        Хотите похожий результат?
      </h2>
      <p class="text-text-secondary mt-4">
        Запишитесь на консультацию — разберёмся с вашей ситуацией
      </p>
      <a
        href="/kontakty"
        class="inline-block bg-primary text-white rounded-xl px-8 py-3.5 font-semibold hover:bg-primary-dark transition mt-8"
      >
        Записаться на приём
      </a>
    </div>
  </section>
</BaseLayout>
