---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeoSchema from '../components/SeoSchema.astro';
import Hero from '../components/sections/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import Specializations from '../components/sections/Specializations.astro';
import Approach from '../components/sections/Approach.astro';
import Stats from '../components/sections/Stats.astro';
import Cases from '../components/sections/Cases.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import MarathonTeaser from '../components/sections/MarathonTeaser.astro';
import CtaBlock from '../components/sections/CtaBlock.astro';

const schemaData = {
  name: 'Елена Чикризова',
  description: 'Врач-эндокринолог высшей категории с 30-летним стажем. Специализация: эндокринология, гирудотерапия, нутрициология.',
  image: 'https://elenachikrizova.vercel.app/images/doctor.jpg',
  telephone: '+7-985-069-35-45',
  email: 'doctor_chikrizova@mail.ru',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Южно-Сахалинск',
    addressRegion: 'Сахалинская область',
    addressCountry: 'RU',
  },
  medicalSpecialty: ['Endocrinology', 'Nutrition'],
  availableService: [
    {
      '@type': 'MedicalProcedure',
      name: 'Консультация эндокринолога',
      description: 'Диагностика и лечение заболеваний эндокринной системы',
    },
    {
      '@type': 'MedicalTherapy',
      name: 'Гирудотерапия',
      description: 'Лечение медицинскими пиявками',
    },
  ],
  priceRange: '2700₽',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    bestRating: '5',
    ratingCount: '150',
  },
  sameAs: [
    'https://prodoctorov.ru/doctors/chikrizova',
  ],
};
---

<BaseLayout
  title="Елена Чикризова — врач-эндокринолог, Южно-Сахалинск"
  description="Врач-эндокринолог с 30-летним стажем. Эндокринология, гирудотерапия, нутрициология. Системный подход к здоровью."
>
  <SeoSchema type="Physician" data={schemaData} slot="head" />
  <Hero />
  <TrustBar />
  <Specializations />
  <Approach />
  <Stats />
  <Cases />
  <Testimonials />
  <MarathonTeaser />
  <CtaBlock />
</BaseLayout>
