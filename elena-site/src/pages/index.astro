---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeoSchema from '../components/SeoSchema.astro';
import Hero from '../components/sections/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import Specializations from '../components/sections/Specializations.astro';
import Approach from '../components/sections/Approach.astro';
import Stats from '../components/sections/Stats.astro';
import Cases from '../components/sections/Cases.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import MarathonTeaser from '../components/sections/MarathonTeaser.astro';
import CtaBlock from '../components/sections/CtaBlock.astro';

const schemaData = {
  name: 'Елена Васильевна Чикризова',
  description: 'Врач-эндокринолог высшей категории с 30-летним стажем',
  image: 'https://elenachikrizova.vercel.app/images/doctor/elena-hero.jpg',
  telephone: '+7 985 069-35-45',
  email: 'doctor_chikrizova@mail.ru',
  url: 'https://elenachikrizova.vercel.app',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Южно-Сахалинск',
    addressRegion: 'Сахалинская область',
    addressCountry: 'RU',
  },
  medicalSpecialty: ['Endocrinology', 'Hirudotherapy'],
  availableService: [
    {
      '@type': 'MedicalProcedure',
      name: 'Онлайн-консультация эндокринолога',
      description: 'Консультация с протоколом из 4 документов',
      offers: {
        '@type': 'Offer',
        price: '8900',
        priceCurrency: 'RUB',
      },
    },
    {
      '@type': 'MedicalProcedure',
      name: 'Гирудотерапия',
      description: 'Лечение медицинскими пиявками',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.3',
    reviewCount: '24',
    bestRating: '5',
  },
  sameAs: [
    'https://prodoctorov.ru/yuzhno-sahalinsk/vrach/991864-chikrizova/',
    'https://t.me/+sWVDcnHhddMzOGIy',
  ],
};
---

<BaseLayout
  title="Врач-эндокринолог Елена Чикризова | Онлайн-консультации | Южно-Сахалинск"
  description="Врач-эндокринолог с 30-летним стажем. Лечение щитовидной железы, диабета, ожирения. Гирудотерапия, нутрициология. Онлайн-консультации по всей России. Запись на приём."
>
  <SeoSchema type="Physician" data={schemaData} slot="head" />
  <Hero />
  <TrustBar />
  <Specializations />
  <Approach />
  <Stats />
  <Cases />
  <Testimonials />
  <MarathonTeaser />
  <CtaBlock />
</BaseLayout>
